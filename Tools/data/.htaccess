# /public_html/data/ e' compartilhada: o site publica aqui os JSON publicos
# (boosters, catalogo, deckbuilder...) e o backend guarda aqui os bancos.
# Bloqueia so' banco e log; os JSON do site continuam publicos.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Mantem as regras da pasta de cima (ex.: http -> https).
  RewriteOptions Inherit
  RewriteRule \.(db|db-journal|db-wal|db-shm|sqlite|sqlite3|log|bak)$ - [F,NC,L]
</IfModule>
<FilesMatch "\.(db|db-journal|db-wal|db-shm|sqlite|sqlite3|log|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
